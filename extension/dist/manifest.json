{
  "manifest_version": 3,
  "name": "Huh?",
  "version": "1.0.0",
  "description": "See something you don't know? Huh?",
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/content.tsx-loader-1wS-B9UL.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://openrouter.ai/*",
    "https://api.x.ai/*",
    "https://api.groq.com/*"
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "assets/jsx-runtime-BRsvpbrG.js",
        "assets/content.tsx-_AiXbwjF.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
