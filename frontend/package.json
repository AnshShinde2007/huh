{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.chrome.ts",
    "build": "npm run build:chrome && npm run build:firefox",
    "build:chrome": "tsc -b && vite build --config vite.config.chrome.ts ",
    "build:firefox": "tsc -b && vite build --config vite.config.firefox.ts && vite build --config vite.content.firefox.config.ts && node scripts/copy-firefox-manifest.js && npx web-ext run --source-dir dist-firefox",
    "watch:chrome": "vite build --config vite.config.chrome.ts --watch",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "^11.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.0.290",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "web-ext": "^10.6.0"
  }
}